{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../../..",
  "testEnvironment": "node",
  "testRegex": "apps/weather/tests/integration/.*\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^apps/(.*)$": "<rootDir>/apps/$1",
    "^libs/(.*)$": "<rootDir>/libs/$1"
  },
  "setupFilesAfterEnv": ["<rootDir>/apps/weather/tests/utils/msw/mock-server.setup.ts"]
}
