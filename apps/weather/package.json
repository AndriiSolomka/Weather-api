{
  "name": "@weather-app/weather",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "platform": "node",
          "outputPath": "apps/weather/dist",
          "format": [
            "cjs"
          ],
          "bundle": false,
          "main": "apps/weather/src/main.ts",
          "tsConfig": "apps/weather/tsconfig.app.json",
          "assets": [
            "apps/weather/src/assets"
          ],
          "esbuildOptions": {
            "sourcemap": true,
            "outExtension": {
              ".js": ".js"
            }
          }
        },
        "configurations": {
          "development": {},
          "production": {
            "esbuildOptions": {
              "sourcemap": false,
              "outExtension": {
                ".js": ".js"
              }
            }
          }
        }
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@weather-app/weather:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@weather-app/weather:build:development"
          },
          "production": {
            "buildTarget": "@weather-app/weather:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      },
      "test-arch": {
        "executor": "@nx/jest:jest",
        "options": {
          "jestConfig": "apps/weather/tests/jest-architecture.json",
          "passWithNoTests": true
        }
      },
      "test-integration": {
        "executor": "@nx/jest:jest",
        "options": {
          "jestConfig": "apps/weather/tests/jest-integration.json",
          "passWithNoTests": true
        }
      }
    }
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.6.2",
    "@bufbuild/protoc-gen-es": "^2.6.2",
    "@connectrpc/connect": "^2.0.3",
    "@connectrpc/connect-fastify": "^2.0.3",
    "close-with-grace": "^2.2.0",
    "prom-client": "^15.1.3",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "msw": "^2.10.4",
    "tsarch": "^5.4.1"
  }
}
